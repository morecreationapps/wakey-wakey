{
  "expo": {
    "name": "Wakey-Wakey!",
    "slug": "wakey-wakey",
    "version": "0.1.0",
    "icon": "./assets/wakey-wakey-icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "wakey-wakey",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morecreationapps.wakeywakey"
    },
    "android": {
      "package": "com.morecreationapps.wakeywakey"
    },
    "web": {
      "bundler": "metro",
      "name": "Wakey-Wakey!",
      "favicon": "./assets/wakey-wakey-icon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-notifications",
      "expo-sharing",
      "expo-secure-store"
    ],
    "extra": {
      "publicReleaseReviewed": false
    }
  }
}
