{
  "name": "wakey-wakey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.13.0 || >=24.3.0"
  },
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm test",
    "export:web": "expo export --platform web",
    "export:pages": "node scripts/export-pages.mjs",
    "check:public": "node scripts/check-public-build.mjs",
    "format": "prettier --write src App.tsx index.ts tests docs README.md",
    "bootstrap": "node scripts/bootstrap.mjs",
    "postinstall": "node scripts/bootstrap.mjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@js-temporal/polyfill": "^0.5.1",
    "expo": "~57.0.27",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-notifications": "~57.0.22",
    "expo-sharing": "~57.0.22",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "vitest": "^4.1.0"
  },
  "type": "module"
}
